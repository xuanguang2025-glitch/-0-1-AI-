{
  "name": "englishai",
  "version": "0.1.0",
  "private": true,
  "description": "EnglishAI · 智能英语学习平台 (Next.js 15 + Prisma 6 + PostgreSQL)",
  "engines": {
    "node": ">=20.11 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/pg-status.mjs && next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:env": "tsx scripts/check-env.ts",
    "prisma:generate": "prisma generate",
    "prisma:sqlite": "tsx scripts/gen-sqlite-schema.ts",
    "enums:sync": "tsx scripts/sync-enums.ts",
    "db:start": "node scripts/pg-daemon.mjs",
    "db:stop": "node scripts/pg-stop.mjs",
    "db:status": "node scripts/pg-status.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:fetch:vocab": "node scripts/fetch-ecdict.mjs",
    "db:build:vocab": "tsx scripts/build-vocab-csv.ts",
    "db:use-cloud": "tsx scripts/use-driver.ts cloud",
    "db:use-sqlite": "tsx scripts/use-driver.ts sqlite"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "3.10.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.104.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "framer-motion": "11.18.2",
    "jose": "5.10.0",
    "lru-cache": "11.5.3",
    "lucide-react": "0.577.0",
    "nanoid": "5.0.7",
    "next": "15.5.26",
    "next-intl": "3.26.5",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "recharts": "2.15.4",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.6.1",
    "dotenv": "^16.6.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "prisma": "6.19.3",
    "@prisma/client": "6.19.3"
  }
}
